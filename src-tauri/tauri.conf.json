{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Play Max",
  "version": "0.1.0",
  "identifier": "com.playmax.app",
  "build": {
    "beforeDevCommand": "powershell -ExecutionPolicy Bypass -File scripts/ensure-vite.ps1 -WaitOnly",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Play Max",
        "width": 1280,
        "height": 720,
        "minWidth": 960,
        "minHeight": 540,
        "transparent": false,
        "backgroundColor": "#0f0f17",
        "decorations": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "lib/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
